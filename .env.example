# ==============================================================================
# FitTrack — Neon PostgreSQL + Vercel Environment Variables Example
# Copy to .env for local development or add to Vercel Project Settings ->
# Environment Variables. NEVER commit real credentials or expose server secrets
# via VITE_* variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon PostgreSQL Database (Required — Server-Side Only)
# ------------------------------------------------------------------------------
# Runtime connection string used by Prisma Client (Neon pooled host recommended
# for Vercel Serverless Functions; must include sslmode=require).
DATABASE_URL="postgresql://neondb_owner:npg_7Y1waRiktsPf@ep-wispy-water-ao0kil8q-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional direct (unpooled) connection string for running `prisma migrate deploy`
# from your terminal or CI:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Optional override path ONLY when running `npm run db:migrate:json` to import an
# existing JSON backup into PostgreSQL (defaults to ./data/fittrack.json):
# FITTRACK_JSON_PATH="./data/fittrack.json"

# Optional comma-separated list of friends/family emails to pre-seed alongside
# the defaults in server/seed.ts (supports "email" or "Name <email>"):
# SEEDED_EMAILS=""
# Set to "true" only if you want anyone with the app URL to register a new account:
# ALLOW_PUBLIC_SIGNUP="false"

# ------------------------------------------------------------------------------
# 2. Server, Runtime & CORS Configuration
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# Canonical production URL (e.g. https://fittrack.vercel.app)
APP_URL="https://fittrack.example.com"

# Optional separate frontend origin (only needed if split-hosted)
FRONTEND_URL=""

# Optional comma-separated list of additional allowed CORS origins
CORS_ALLOWED_ORIGINS=""

# ------------------------------------------------------------------------------
# 3. Frontend Build-Time Variable (Public — bundled into client JS)
# ------------------------------------------------------------------------------
# Leave empty ("") for single-project Vercel deployment (same-origin /api/*).
VITE_API_BASE_URL=""

# ------------------------------------------------------------------------------
# 4. AI Assistant Provider Configuration (Server-Side Only — Never VITE_*)
# ------------------------------------------------------------------------------
# Supported: "gemini" (default) | "openai" | "anthropic" | "deepseek" | "openai_compatible"
AI_PROVIDER="gemini"
# Optional dedicated 32+ char secret used to encrypt user-supplied AI API keys at rest:
# AI_KEY_ENCRYPTION_SECRET=""

# --- Google Gemini (Default) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
# Optional fallback model tried only if explicitly configured and primary remains unavailable after retries:
# GEMINI_FALLBACK_MODEL=""

# --- OpenAI (when AI_PROVIDER="openai") ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Anthropic Claude (when AI_PROVIDER="anthropic") ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# --- DeepSeek (when AI_PROVIDER="deepseek") ---
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# --- Custom OpenAI-Compatible Endpoint (when AI_PROVIDER="openai_compatible") ---
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_MODEL=""